# Agento secrets — DO NOT commit this file
# Copy to secrets.env and fill in the value below.
#
# secrets.env holds ONE secret only: the master encryption key. Every other
# credential (Jira, SMTP, database logins, API tokens, ...) is stored encrypted
# in the database and decrypted at runtime with this key — do not put it here.

# Master encryption key for config values (generate with: openssl rand -hex 32)
AGENTO_ENCRYPTION_KEY=

# Set other credentials as encrypted config instead, e.g.:
#   bin/agento config:set jira/jira_host https://your-instance.atlassian.net
#   bin/agento config:set jira/jira_user you@example.com
#   bin/agento config:set jira/jira_token <api-token>
