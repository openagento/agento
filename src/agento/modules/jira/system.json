{
  "enabled": {"type": "boolean", "label": "Enable Jira channel"},
  "user": {"type": "string", "label": "AI User"},
  "jira_projects": {"type": "json", "label": "Jira Projects (JSON array)"},
  "jira_assignee": {"type": "string", "label": "Agent username in Jira"},
  "jira_assignee_account_id": {"type": "string", "label": "Agent Jira account ID (for mention detection)"},
  "jira_host": {"type": "string", "label": "Jira Cloud URL", "tester": {"kind": "http", "url": "{jira/jira_host}/rest/api/2/myself", "basic": ["{jira/jira_user}", "{jira/jira_token}"], "expect": 200}},
  "jira_user": {"type": "string", "label": "Jira API user email", "tester": {"kind": "http", "url": "{jira/jira_host}/rest/api/2/myself", "basic": ["{jira/jira_user}", "{jira/jira_token}"], "expect": 200}},
  "jira_token": {"type": "obscure", "label": "Jira API token", "tester": {"kind": "http", "url": "{jira/jira_host}/rest/api/2/myself", "basic": ["{jira/jira_user}", "{jira/jira_token}"], "expect": 200}},
  "jira_admin_token": {"type": "obscure", "label": "Jira admin API token (optional, enables auto-configuration of statuses, fields, and screens)", "tester": {"kind": "http", "url": "{jira/jira_host}/rest/api/2/myself", "basic": ["{jira/jira_admin_user}", "{jira/jira_admin_token}"], "expect": 200}},
  "jira_admin_user": {"type": "string", "label": "Jira admin user email (owner of jira_admin_token; falls back to jira_user when unset)", "tester": {"kind": "http", "url": "{jira/jira_host}/rest/api/2/myself", "basic": ["{jira/jira_admin_user}", "{jira/jira_admin_token}"], "expect": 200}},
  "todo_statuses": {"type": "json", "label": "Jira statuses treated as To Do (JSON array)"},
  "create_issue_limit_per_hour": {"type": "integer", "label": "Max issues created per hour"},
  "attachment_download_limit": {"type": "integer", "label": "Max newest attachments auto-downloaded by jira_get_issue (0 = all)"}
}
