{
  "job_types": [
    "scheduler"
  ],
  "channels": [
    {"name": "scheduler", "class": "src.channel.SchedulerChannel"}
  ],
  "workflows": [
    {"type": "scheduler", "class": "src.workflow.SchedulerWorkflow"}
  ],
  "schedule_sources": [
    {"name": "scheduler", "class": "src.source.SchedulerSource"}
  ],
  "routes": [
    {"method": "GET", "path": "/api/scheduler/schedules", "handler": "src.routes.list_schedules", "acl": "self"},
    {"method": "POST", "path": "/api/scheduler/schedules", "handler": "src.routes.create", "json_body": true,
     "acl": "self"},
    {"method": "GET", "path": "/api/scheduler/options", "handler": "src.routes.options", "acl": "self"},
    {"method": "POST", "path": "/api/scheduler/preview", "handler": "src.routes.preview", "json_body": true,
     "acl": "self"},
    {"method": "GET", "path": "/api/scheduler/schedules/(?P<id>[0-9]{1,18})", "handler": "src.routes.get_schedule",
     "acl": "self"},
    {"method": "PATCH", "path": "/api/scheduler/schedules/(?P<id>[0-9]{1,18})", "handler": "src.routes.update",
     "json_body": true, "acl": "self"},
    {"method": "DELETE", "path": "/api/scheduler/schedules/(?P<id>[0-9]{1,18})", "handler": "src.routes.delete",
     "acl": "self"},
    {"method": "POST", "path": "/api/scheduler/schedules/(?P<id>[0-9]{1,18})/run", "handler": "src.routes.run_now",
     "acl": "self"},
    {"method": "GET", "path": "/api/scheduler/schedules/(?P<id>[0-9]{1,18})/runs", "handler": "src.routes.runs",
     "acl": "self"},
    {"method": "GET", "path": "/api/scheduler/schedules/(?P<id>[0-9]{1,18})/member-options",
     "handler": "src.routes.member_options", "acl": "self"},
    {"method": "PUT", "path": "/api/scheduler/schedules/(?P<id>[0-9]{1,18})/members", "handler": "src.routes.put_member",
     "json_body": true, "acl": "self"},
    {"method": "DELETE", "path": "/api/scheduler/schedules/(?P<id>[0-9]{1,18})/members/(?P<user_id>[0-9]{1,10})",
     "handler": "src.routes.delete_member", "acl": "self"},
    {"method": "POST", "path": "/api/scheduler/schedules/(?P<id>[0-9]{1,18})/owner", "handler": "src.routes.change_owner",
     "json_body": true, "acl": "self"}
  ]
}
