{
  "routes": [
    {"method": "GET", "path": "/api/miniapps/apps", "handler": "src.routes.catalogue", "acl": "self"},
    {"method": "GET", "path": "/api/miniapps/agent-views", "handler": "src.routes.launch_views", "acl": "self"},
    {"method": "POST", "path": "/api/miniapps/launches", "handler": "src.routes.create_launch", "json_body": true,
     "acl": "self"},
    {"method": "POST", "path": "/api/miniapps/previews", "handler": "src.routes.create_preview", "json_body": true,
     "acl": "self"},
    {"method": "GET", "path": "/api/miniapps/apps/(?P<code>[a-z0-9-]{1,64})", "handler": "src.routes.app",
     "acl": "self"},
    {"method": "PATCH", "path": "/api/miniapps/apps/(?P<code>[a-z0-9-]{1,64})", "handler": "src.routes.update_app",
     "json_body": true, "acl": "self"},
    {"method": "DELETE", "path": "/api/miniapps/apps/(?P<code>[a-z0-9-]{1,64})", "handler": "src.routes.delete_app",
     "acl": "self"},
    {"method": "GET", "path": "/api/miniapps/apps/(?P<code>[a-z0-9-]{1,64})/member-options",
     "handler": "src.routes.member_options", "acl": "self"},
    {"method": "PUT", "path": "/api/miniapps/apps/(?P<code>[a-z0-9-]{1,64})/members", "handler": "src.routes.put_member",
     "json_body": true, "acl": "self"},
    {"method": "DELETE", "path": "/api/miniapps/apps/(?P<code>[a-z0-9-]{1,64})/members/(?P<id>[0-9]{1,10})",
     "handler": "src.routes.delete_member", "acl": "self"},
    {"method": "GET", "path": "/api/miniapps/apps/(?P<code>[a-z0-9-]{1,64})/approvals", "handler": "src.routes.approvals",
     "acl": "self"},
    {"method": "GET", "path": "/api/miniapps/apps/(?P<code>[a-z0-9-]{1,64})/views/(?P<view>[0-9]{1,10})/approval",
     "handler": "src.routes.approval", "acl": "self"},
    {"method": "POST", "path": "/api/miniapps/apps/(?P<code>[a-z0-9-]{1,64})/views/(?P<view>[0-9]{1,10})/approval",
     "handler": "src.routes.approve", "json_body": true, "acl": "self"},
    {"method": "DELETE", "path": "/api/miniapps/apps/(?P<code>[a-z0-9-]{1,64})/views/(?P<view>[0-9]{1,10})/approval",
     "handler": "src.routes.revoke", "acl": "self"}
  ]
}
