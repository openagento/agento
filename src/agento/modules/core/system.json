{
  "timezone": {"type": "string", "label": "IANA timezone (e.g., America/New_York)"},
  "sql_timeout_seconds": {"type": "integer", "label": "SQL query timeout (seconds)"},
  "client_connection_pool_max_per_tool": {"type": "integer", "label": "Maximum client DB connections per tool"},
  "server_concurrency_budget": {"type": "integer", "label": "Maximum concurrent DB operations per server", "showInDefault": true, "showInWorkspace": false, "showInAgentView": false},
  "email_whitelist": {"type": "string", "label": "Allowed email recipients (comma-separated)"},
  "smtp_host": {"type": "string", "label": "SMTP host", "tester": {"kind": "smtp", "host": "{core/smtp_host}", "port": "{core/smtp_port}", "user": "{core/smtp_user}", "pass": "{core/smtp_pass}"}},
  "smtp_port": {"type": "integer", "label": "SMTP port", "tester": {"kind": "smtp", "host": "{core/smtp_host}", "port": "{core/smtp_port}", "user": "{core/smtp_user}", "pass": "{core/smtp_pass}"}},
  "smtp_user": {"type": "string", "label": "SMTP user", "tester": {"kind": "smtp", "host": "{core/smtp_host}", "port": "{core/smtp_port}", "user": "{core/smtp_user}", "pass": "{core/smtp_pass}"}},
  "smtp_pass": {"type": "obscure", "label": "SMTP password", "tester": {"kind": "smtp", "host": "{core/smtp_host}", "port": "{core/smtp_port}", "user": "{core/smtp_user}", "pass": "{core/smtp_pass}"}},
  "smtp_from": {"type": "string", "label": "SMTP from address"},
  "allowed_domains": {"type": "string", "label": "Allowed browser domains (comma-separated)"},
  "allow_subdomains": {"type": "boolean", "label": "Allow subdomains for browser"},
  "allow_http": {"type": "boolean", "label": "Allow HTTP (not just HTTPS) for browser"},
  "auth/session_max_ttl": {"type": "integer", "label": "Max user session lifetime (seconds, hard ceiling 86400)", "showInDefault": true, "showInWorkspace": true, "showInAgentView": false},
  "auth/launch_max_ttl": {"type": "integer", "label": "Max miniapp launch lifetime (seconds, hard ceiling 43200)", "showInDefault": true, "showInWorkspace": true, "showInAgentView": false},
  "auth/capability_ttl": {"type": "integer", "label": "User/miniapp capability lifetime (seconds, hard ceiling 300)", "showInDefault": true, "showInWorkspace": true, "showInAgentView": false},
  "toolbox/url": {"type": "string", "label": "Toolbox base URL (agents append /mcp or /sse)"},
  "toolbox/file_manager/allowed_extensions": {"type": "string", "label": "Allowed file extensions (comma-separated)"},
  "toolbox/file_manager/max_file_size": {"type": "integer", "label": "Max file size in bytes"},
  "toolbox/result_offload/threshold": {"type": "integer", "label": "Result offload size threshold (bytes)"},
  "toolbox/result_offload/sample_rows": {"type": "integer", "label": "Number of sample rows in offload summary"},
  "toolbox/result_offload/text_preview_chars": {"type": "integer", "label": "Number of preview chars for text offload"}
}
