{
  "commands": [
    {
      "name": "artifact:auth",
      "class": "src.commands.auth.VersionedArtifactAuthCommand"
    }
  ],
  "routes": [
    {"method": "GET", "path": "/api/versioned_artifacts/artifacts", "handler": "src.routes.list_artifacts"},
    {"method": "GET", "path": "/api/versioned_artifacts/artifacts/(?P<code>[a-z0-9-]{1,64})/versions",
     "handler": "src.routes.versions"},
    {"method": "POST", "path": "/api/versioned_artifacts/artifacts/(?P<code>[a-z0-9-]{1,64})/publish",
     "handler": "src.routes.make_current", "json_body": true},
    {"method": "DELETE", "path": "/api/versioned_artifacts/artifacts/(?P<code>[a-z0-9-]{1,64})",
     "handler": "src.routes.delete"}
  ]
}
