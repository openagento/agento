{
  "name": "agento-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "packages/*",
    "panel"
  ],
  "scripts": {
    "gen": "node --experimental-strip-types --no-warnings packages/miniapp-kit/scripts/build-kit.ts && node --experimental-strip-types --no-warnings packages/miniapp-kit/scripts/gen-skill.ts && node --experimental-strip-types --no-warnings panel/scripts/gen-registry.ts",
    "build": "npm run gen && tsc -p . && vite build panel",
    "typecheck": "npm run gen && tsc -p .",
    "lint": "eslint . && cd ../src/agento/modules && eslint --max-warnings 0 --config ../../../frontend/eslint.config.js \"*/panel/**/*.{ts,tsx}\"",
    "test": "node --experimental-strip-types --no-warnings packages/miniapp-kit/scripts/gen-skill.ts --check && npm run build && npm run lint && playwright install chromium && vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "dev": "npm run gen && vite build panel --watch"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@mantine/notifications": "9.6.3",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "9.2.4",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "storybook": "10.6.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
