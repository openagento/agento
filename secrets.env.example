# Agento — Secrets Configuration
# Copy this file to secrets.env and fill in the value below.
# IMPORTANT: Never commit secrets.env to git!
#
# secrets.env holds ONE secret only: the master encryption key. Every other
# credential (Jira, SMTP, per-system database logins, API tokens, ...) is stored
# encrypted in the database and decrypted at runtime with this key — it must not
# be written here in plaintext. A key vault backend is planned; see ROADMAP.md.

# Master encryption key for config values (generate with: openssl rand -hex 32)
AGENTO_ENCRYPTION_KEY=

# Set every other credential as encrypted config instead, e.g.:
#   bin/agento config:set jira/jira_host https://your-instance.atlassian.net
#   bin/agento config:set jira/jira_user you@example.com
#   bin/agento config:set jira/jira_token <api-token>
# Fields declared as "obscure" in a module's system.json are encrypted with
# AGENTO_ENCRYPTION_KEY before they are written to core_config_data.
